/* -------------------------------------------------------------------------- */
/*  TrendMart — Next.js Middleware                                             */
/*  Auth session refresh | Route protection | Security headers | Rate limiting  */
/*  Multi-Tenant Role-Based Access Control (RBAC)                              */
/*                                                                              */
/*  Role Hierarchy: public → customer → merchant → admin                       */
/*  - Public routes:     /, /search, /shop/:id, /login, /signup, /auth/*       */
/*  - Customer routes:   /orders, /wishlist, /auth/settings                    */
/*  - Merchant routes:   /dashboard, /dashboard/products, /shop/manage         */
/*  - Admin routes:      /admin/*                                              */
/* -------------------------------------------------------------------------- */

import { type NextRequest, NextResponse } from "next/server";
import { updateSession } from "@/lib/supabase/middleware";
import { createServerClient } from "@supabase/ssr";

// ─── Rate Limiting ───────────────────────────────────────────────────────────

/** Maximum requests allowed within the window per identifier (IP or session). */
const RATE_LIMIT_MAX = 30;

/** Time window in milliseconds (15 seconds). */
const RATE_LIMIT_WINDOW_MS = 15_000;

/** Sensitive path patterns that get stricter rate limits. */
const SENSITIVE_PATH_PATTERNS = [
  "/api/",
  "/auth/",
  "/dashboard/",
  "/admin/",
  "/login",
  "/signup",
] as const;

/** Stricter limit for sensitive endpoints (e.g. shop creation, mutations, auth). */
const SENSITIVE_RATE_LIMIT_MAX = 10;

interface RateLimitEntry {
  count: number;
  resetAt: number;
}

/** In-memory store (per-edge-worker). Resets on cold-start. */
const rateLimitStore = new Map<string, RateLimitEntry>();

/** Clean up expired entries periodically to prevent memory leaks. */
let lastCleanup = Date.now();
const CLEANUP_INTERVAL_MS = 60_000; // 1 minute

function cleanExpiredEntries(now: number): void {
  if (now - lastCleanup < CLEANUP_INTERVAL_MS) return;
  lastCleanup = now;
  for (const [key, entry] of rateLimitStore) {
    if (now > entry.resetAt) {
      rateLimitStore.delete(key);
    }
  }
}

/**
 * Derive a rate-limit key from the request.
 * Prefers session cookie; falls back to IP address.
 */
function getRateLimitKey(request: NextRequest): string {
  const sessionCookie =
    request.cookies.get("sb-access-token")?.value ??
    request.cookies.get("sb-refresh-token")?.value;

  if (sessionCookie) {
    return `session:${sessionCookie.slice(0, 16)}`;
  }

  const ip =
    request.headers.get("x-forwarded-for")?.split(",")[0]?.trim() ??
    request.headers.get("x-real-ip") ??
    "unknown";
  const ua = request.headers.get("user-agent")?.slice(0, 32) ?? "";
  return `ip:${ip}:${ua}`;
}

function checkRateLimit(request: NextRequest): boolean {
  const now = Date.now();
  cleanExpiredEntries(now);

  const key = getRateLimitKey(request);
  const pathname = request.nextUrl.pathname;

  const isSensitive = SENSITIVE_PATH_PATTERNS.some((pattern) =>
    pathname.startsWith(pattern),
  );
  const maxRequests = isSensitive ? SENSITIVE_RATE_LIMIT_MAX : RATE_LIMIT_MAX;

  const existing = rateLimitStore.get(key);

  if (!existing || now > existing.resetAt) {
    rateLimitStore.set(key, { count: 1, resetAt: now + RATE_LIMIT_WINDOW_MS });
    return true;
  }

  existing.count++;

  if (existing.count > maxRequests) {
    return false;
  }

  return true;
}

// ─── Role & Route Configuration ────────────────────────────────────────────

type AppRole = "customer" | "merchant" | "admin";

const ROLE_HIERARCHY: Record<AppRole, number> = {
  customer: 0,
  merchant: 1,
  admin: 2,
};

/**
 * Route segments grouped by minimum required role.
 * Routes not listed here are considered public (no auth required).
 */
const ROLE_ROUTE_MAP = {
  /** Routes that require at minimum an authenticated user (any role). */
  customer: ["/orders", "/wishlist", "/auth/settings"],
  /** Routes that require merchant or higher. */
  merchant: ["/dashboard", "/shop/manage"],
  /** Routes that require admin role exclusively. */
  admin: ["/admin"],
} as const;

/**
 * Paths where authenticated users should NOT be redirected away from.
 * These are the auth pages (login, signup, /auth root).
 */
const AUTH_ROUTES = ["/login", "/signup", "/auth"] as const;

/**
 * Determine the minimum required role for a given pathname.
 */
function getRequiredRole(pathname: string): AppRole | "public" {
  if (ROLE_ROUTE_MAP.admin.some((route) => pathname.startsWith(route))) return "admin";
  if (ROLE_ROUTE_MAP.merchant.some((route) => pathname.startsWith(route))) return "merchant";
  if (ROLE_ROUTE_MAP.customer.some((route) => pathname.startsWith(route))) return "customer";
  return "public";
}

/**
 * Check if the given pathname is an auth page (login/signup/auth).
 */
function isAuthRoute(pathname: string): boolean {
  return AUTH_ROUTES.some((route) => pathname.startsWith(route));
}

/**
 * Verify a route is accessible by the given role.
 */
function canAccessRoute(role: AppRole | null, pathname: string): boolean {
  const required = getRequiredRole(pathname);
  if (required === "public") return true;
  if (!role) return false;
  return ROLE_HIERARCHY[role] >= ROLE_HIERARCHY[required];
}

// ─── Session & Role Resolution ────────────────────────────────────────────

/**
 * Verify if the user has a valid session by checking for the
 * Supabase auth cookies that are set after a successful login.
 */
function hasValidSession(request: NextRequest): boolean {
  const accessToken = request.cookies.get("sb-access-token")?.value;
  const refreshToken = request.cookies.get("sb-refresh-token")?.value;
  return !!(accessToken || refreshToken);
}

/**
 * Fetch the user's role from the `user_roles` table using the Supabase
 * server client. This is called within the middleware for protected routes.
 *
 * Returns `null` if the user is not authenticated or the role cannot be
 * determined. In that case, they are treated as an unauthenticated visitor.
 */
async function resolveUserRole(request: NextRequest): Promise<AppRole | null> {
  try {
    // Create a server client using the request cookies
    const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

    if (!supabaseUrl || !supabaseAnonKey) {
      return null; // Env vars missing — cannot authenticate, treat as unauthenticated
    }

    const supabase = createServerClient(supabaseUrl, supabaseAnonKey, {
        cookies: {
          getAll() {
            return request.cookies.getAll();
          },
          setAll() {
            // No-op: middleware shouldn't set cookies during role resolution
            // (that's handled by updateSession)
          },
        },
      },
    );

    // Get the authenticated user
    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user) return null;

    // Fetch the user's role from the user_roles table
    const { data: roleData, error: roleError } = await supabase
      .from("user_roles")
      .select("role")
      .eq("user_id", user.id)
      .single();

    if (roleError || !roleData) {
      // If no role record exists yet (race condition after signup),
      // default to "customer" for authenticated users
      return "customer";
    }

    return roleData.role as AppRole;
  } catch {
    return null;
  }
}

// ─── Middleware ──────────────────────────────────────────────────────────────

export async function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;

  // ── 1. Rate limiting check (before any processing) ──────────────────────
  if (!checkRateLimit(request)) {
    const retryAfter = Math.ceil(RATE_LIMIT_WINDOW_MS / 1000);
    return new NextResponse(
      JSON.stringify({
        error: "Too many requests. Please slow down and try again.",
        retryAfter,
      }),
      {
        status: 429,
        headers: {
          "Content-Type": "application/json",
          "Retry-After": String(retryAfter),
          "X-RateLimit-Limit": String(
            SENSITIVE_PATH_PATTERNS.some((p) => pathname.startsWith(p))
              ? SENSITIVE_RATE_LIMIT_MAX
              : RATE_LIMIT_MAX,
          ),
        },
      },
    );
  }

  // ── 2. Determine required role for this route ───────────────────────────
  const requiredRole = getRequiredRole(pathname);
  const authenticated = hasValidSession(request);

  // ── 3. For PUBLIC routes: skip Supabase entirely, return fast ───────────
  //    No auth needed — serve the page immediately without waiting for
  //    Supabase session checks. This avoids hanging when Supabase is
  //    unreachable or the ANON key is invalid.
  if (requiredRole === "public" && !isAuthRoute(pathname)) {
    const response = NextResponse.next({
      request: { headers: request.headers },
    });
    // Still apply security headers to public pages
    const h = response.headers;
    h.set("X-Frame-Options", "DENY");
    h.set("X-Content-Type-Options", "nosniff");
    h.set("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
    h.set("Referrer-Policy", "strict-origin-when-cross-origin");
    h.set("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
    h.set("Cross-Origin-Opener-Policy", "same-origin");
    h.set("X-XSS-Protection", "1; mode=block");
    // Build CSP policy with dev-friendly WebSocket support
    const cspDirectives = [
      "default-src 'self'",
      "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.supabase.co",
      "style-src 'self' 'unsafe-inline'",
      "img-src 'self' data: https: blob:",
      "connect-src 'self' https://*.supabase.co https://*.supabase.in",
      "font-src 'self'",
      "frame-src 'none'",
      "object-src 'none'",
      "base-uri 'self'",
      "form-action 'self'",
    ];
    // In development, allow WebSocket connections for Turbopack HMR
    if (process.env.NODE_ENV !== "production") {
      cspDirectives[4] = "connect-src 'self' ws: wss: https://*.supabase.co https://*.supabase.in";
    }
    h.set("Content-Security-Policy", cspDirectives.join("; "));
    return response;
  }

  // ── 4. Refresh Supabase auth session (only for protected + auth routes) ─
  const supabaseResponse = await updateSession(request);

  // ── 5. Resolve user role for RBAC ───────────────────────────────────────
  let userRole: AppRole | null = null;
  if (authenticated) {
    userRole = await resolveUserRole(request);
  }

  // ── 6. Role-based route protection ──────────────────────────────────────

  // 6a. Admin-only routes
  if (requiredRole === "admin") {
    if (!authenticated) {
      const loginUrl = new URL("/login", request.url);
      loginUrl.searchParams.set("redirect", pathname);
      return NextResponse.redirect(loginUrl);
    }
    if (userRole !== "admin") {
      return new NextResponse(
        JSON.stringify({ error: "Forbidden: Insufficient permissions." }),
        { status: 403, headers: { "Content-Type": "application/json" } },
      );
    }
  }

  // 6b. Merchant routes — must be merchant or admin
  if (requiredRole === "merchant") {
    if (!authenticated) {
      const loginUrl = new URL("/login", request.url);
      loginUrl.searchParams.set("redirect", pathname);
      return NextResponse.redirect(loginUrl);
    }
    if (!userRole || ROLE_HIERARCHY[userRole] < ROLE_HIERARCHY.merchant) {
      return NextResponse.redirect(new URL("/", request.url));
    }
  }

  // 6c. Customer (authenticated) routes — any logged-in user
  if (requiredRole === "customer") {
    if (!authenticated) {
      const loginUrl = new URL("/login", request.url);
      loginUrl.searchParams.set("redirect", pathname);
      return NextResponse.redirect(loginUrl);
    }
  }

  // ── 7. Redirect authenticated users away from auth pages ────────────────
  if (isAuthRoute(pathname) && authenticated) {
    if (userRole === "admin") {
      return NextResponse.redirect(new URL("/admin", request.url));
    }
    return NextResponse.redirect(new URL("/dashboard", request.url));
  }

  // ── 8. Build the response with security headers ─────────────────────────
  const response = NextResponse.next({
    request: { headers: request.headers },
  });

  // Copy all Supabase cookies from the supabase response
  supabaseResponse.cookies.getAll().forEach((cookie) => {
    response.cookies.set(cookie.name, cookie.value, cookie);
  });

  // Preserve supabase response status if modified (e.g., token refresh)
  if (supabaseResponse.status !== 200 && supabaseResponse.status !== 307) {
    return supabaseResponse;
  }

  // ── 9. Add role context to request headers ──────────────────────────────
  if (userRole) {
    response.headers.set("X-User-Role", userRole);
  }

  // ── 10. Secure HTTP Headers ─────────────────────────────────────────────
  const headers = response.headers;
  headers.set("X-Frame-Options", "DENY");
  headers.set("X-Content-Type-Options", "nosniff");
  headers.set("Strict-Transport-Security", "max-age=31536000; includeSubDomains");
  headers.set("Referrer-Policy", "strict-origin-when-cross-origin");
  headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
  headers.set("Cross-Origin-Opener-Policy", "same-origin");
  headers.set("X-XSS-Protection", "1; mode=block");
  // Build CSP policy with dev-friendly WebSocket support
  const cspDirectives2 = [
    "default-src 'self'",
    "script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.supabase.co",
    "style-src 'self' 'unsafe-inline'",
    "img-src 'self' data: https: blob:",
    "connect-src 'self' https://*.supabase.co https://*.supabase.in",
    "font-src 'self'",
    "frame-src 'none'",
    "object-src 'none'",
    "base-uri 'self'",
    "form-action 'self'",
  ];
  // In development, allow WebSocket connections for Turbopack HMR
  if (process.env.NODE_ENV !== "production") {
    cspDirectives2[4] = "connect-src 'self' ws: wss: https://*.supabase.co https://*.supabase.in";
  }
  headers.set("Content-Security-Policy", cspDirectives2.join("; "));

  return response;
}

export const config = {
  matcher: [
    /*
     * Match all request paths except:
     * - _next/static (static files)
     * - _next/image (image optimization files)
     * - favicon.ico (favicon file)
     * - public files (images, etc.)
     */
    "/((?!_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)",
  ],
};