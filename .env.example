# mandatory
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TrendsMart
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trendsmart-media

# optional
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_TEAM_EMAIL=
# Server-only Google Places API key (billable — never NEXT_PUBLIC_)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
# ── Cloudinary (product/shop image CDN) ─────────────────────────────────────
# Server-only credentials — used for signed image deletion.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Client-safe: cloud name + an UNSIGNED upload preset created in the
# Cloudinary dashboard (Settings → Upload → Add unsigned preset). When these
# are set, new uploads go to Cloudinary; otherwise the app silently keeps
# using Supabase Storage, so existing images are never affected.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service (required by Web Push spec)
VAPID_SUBJECT=mailto:support@trendsmart.pk
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
REVIEW_IP_SALT=

# Show polished demo sponsored ads when the DB has none (dev: on by default).
# Set to "true" on Vercel for preview testing, or run the demo ads SQL migration.
NEXT_PUBLIC_DEMO_ADS=true
