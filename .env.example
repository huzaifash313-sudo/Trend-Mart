# =============================================================================
# TrendsMart — Environment Variables
# Copy to `.env.local` for local dev. Set the same keys on Vercel Production.
# =============================================================================

# ── mandatory ───────────────────────────────────────────────────────────────
NODE_ENV=development

# LOCAL DEV — use localhost:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VERCEL PRODUCTION — set both to your live origin (never *.vercel.app):
# NEXT_PUBLIC_APP_URL=https://your-domain.pk
# NEXT_PUBLIC_SITE_URL=https://your-domain.pk

NEXT_PUBLIC_SITE_NAME=TrendsMart
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trendmart-media

# ── email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# Public From address — VAPID subject is auto-derived from this (support@domain)
EMAIL_FROM=TrendsMart <support@your-domain.pk>
# Inbox that receives support tickets (can be a personal Gmail)
SUPPORT_TEAM_EMAIL=

# ── web push ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional override — otherwise mailto: is derived from EMAIL_FROM
# VAPID_SUBJECT=mailto:support@your-domain.pk

# ── maps (optional) ───────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Cloudinary (product/shop image CDN) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── optional integrations ───────────────────────────────────────────────────
DATABASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile (easy captcha — free) ──────────────────────────────
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Create a widget (Managed mode). Most users never see a puzzle.
# Local test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXTAUTH_URL=
NEXTAUTH_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── admin bootstrap (npm run bootstrap-admin) ───────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=admin@trendsmart.pk
ADMIN_BOOTSTRAP_PASSWORD=

# ── review anti-spam (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
REVIEW_IP_SALT=

# ── TrendBot free LLM (optional — makes multilingual understanding much stronger)
# Prefer ONE key. Without any key, rule-engine + honest refuse still works.
# Groq (recommended): https://console.groq.com → API Keys (free, no card, very fast)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
# OR Google Gemini: https://aistudio.google.com/apikey (free tier)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Demo sponsored ads when the DB has none (on by default in dev)
# NEXT_PUBLIC_DEMO_ADS=false
