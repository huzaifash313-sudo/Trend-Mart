# =============================================================================
# TrendMart — Environment Variables (safe template — commit this file)
# Copy to `.env` or `.env.local` and fill real values. NEVER commit secrets.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── App URLs (REQUIRED for auth email / OTP redirects) ───────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TrendMart

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=trendmart-media
# Paste URI only in .env.local (never commit). Leave empty here so CI secret-scan stays clean.
DATABASE_URL=

# ── Branded Email / Verification — Resend (SHOULD for production) ────────────
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=TrendMart <notifications@yourdomain.com>
# SUPPORT_TEAM_EMAIL=support@yourdomain.com

# ── Google Maps / Places (SHOULD for local POI search) ───────────────────────
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-browser-restricted-key

# ── Mapbox (OPTIONAL) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# ── Cloudinary (OPTIONAL — if not using Supabase Storage alone) ──────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Phone OTP via Twilio (OPTIONAL direct API; usually configure in Supabase) ─
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Sentry (OPTIONAL monitoring) ─────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Analytics (OPTIONAL) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_FACEBOOK_APP_ID=

# ── Upstash Redis rate limits (OPTIONAL) ─────────────────────────────────────
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# ── Auth helpers (OPTIONAL / legacy) ─────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# ── Payments (OPTIONAL — not required for WhatsApp-first) ────────────────────
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Web Push / PWA extras (OPTIONAL) ─────────────────────────────────────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
